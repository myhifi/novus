# ═══════════════════════════════════════════════════
# 🛒 shop/ — Environment variables (example)
# ═══════════════════════════════════════════════════
# Copy to `.env` and fill in real values:
#   cp .env.example .env

# ─── Database (Neon PostgreSQL) ───
# Runtime connection. On Neon, use the DIRECT endpoint
# (no "-pooler" suffix) — Vercel serverless connections
# are rejected by the pooler.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&connect_timeout=30"

# Migration connection. Same host, no pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"